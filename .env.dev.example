# Development Ortam Yapılandırması
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=django-insecure-dev-local-secret-key-123456
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database (PostgreSQL Dev)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=custom_rss_dev
DB_USER=custom_rss_dev
DB_PASSWORD=custom_rss_dev_password
DB_HOST=db
DB_PORT=5432

# Superuser Auto-Creation
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@dev.local

# API Keys
WRITE_API_KEY=crss_write_dev_token
READ_API_KEY=crss_read_dev_token

PORT=8000
