# Django Settings
DEBUG=False
SECRET_KEY=degistirin-guvenli-uzun-rastgele-bir-secret-key-girin
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://rss.yourdomain.com,http://localhost:8000

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=custom_rss
DB_USER=custom_rss
DB_PASSWORD=cok_guclu_bir_veritabani_sifresi
DB_HOST=db
DB_PORT=5432

# Superuser Auto-Creation (Container ilk açıldığında otomatik tanımlanır)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=guclu_admin_sifresi_123
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com

# API Keys (Opsiyonel: DB harici ortam değişkeni ile hızlı anahtar)
WRITE_API_KEY=crss_write_n8n_secret_token_example
READ_API_KEY=crss_read_rss_client_token_example

# Feed Settings
RSS_FEED_LIMIT=50
PORT=8000
