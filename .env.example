# Ortam Seçimi: production veya development (Portainer UI veya .env üzerinden verilebilir)
ENVIRONMENT=production
DEBUG=False

# Django Ayarları
SECRET_KEY=degistirin-guvenli-uzun-rastgele-bir-secret-key-girin
ALLOWED_HOSTS=crss.armaganuzun.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://crss.armaganuzun.com,http://localhost:8000,http://127.0.0.1:8000

# Veritabanı (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=custom_rss
DB_USER=custom_rss
DB_PASSWORD=cok_guclu_bir_veritabani_sifresi
DB_HOST=db
DB_PORT=5432

# Superuser Otomatik Tanımlama (Container ilk açıldığında otomatik tanımlanır)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=guclu_admin_sifresi_123
DJANGO_SUPERUSER_EMAIL=admin@armaganuzun.com

# Django Admin Paneli Özelleştirme (Docker Environment üzerinden değiştirilebilir)
DJANGO_ADMIN_SITE_HEADER=Custom RSS Yönetimi
DJANGO_ADMIN_SITE_TITLE=Custom RSS Yönetim Paneli
DJANGO_ADMIN_INDEX_TITLE=Akış ve API Yönetimi

# NOT: API Anahtarları (Write ve Read) ortam değişkeni yerine güvenli biçimde
# doğrudan Django Admin panelinden (/admin/feeds/apikey/) dinamik olarak oluşturulur.

# Feed Ayarları
RSS_FEED_LIMIT=50
PORT=8000
